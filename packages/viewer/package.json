{
  "name": "@deblob/viewer",
  "version": "0.0.0",
  "description": "The deblob viewer: a browser app over a deblob-extracted codebase. Launched by `deblob view`.",
  "license": "MIT",
  "author": "rixo",
  "repository": {
    "type": "git",
    "url": "https://github.com/rixo/deblob",
    "directory": "packages/viewer"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./snapshot.model": {
      "types": "./src/lib/snapshot/snapshot.model.ts",
      "default": "./src/lib/snapshot/snapshot.model.ts"
    },
    "./bundle/*": {
      "default": "./dist/*"
    }
  },
  "files": [
    "README.md",
    "dist",
    "src/lib/snapshot/snapshot.model.ts"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "npm-run-all2": "^9.0.2",
    "parse5": "8.0.1",
    "svelte": "5.57.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "ws": "8.21.3"
  },
  "scripts": {
    "build": "vite build",
    "check": "node ../deblob/src/drivers/cli/bin.ts check",
    "dev": "run-p dev:*",
    "dev:serve": "node --watch ../deblob/src/drivers/serve/bin.ts",
    "dev:vite": "vite",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
